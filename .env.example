# SAEDGE Embodied AI Studio - environment configuration
# Copy to .env and adjust for your Jetson Orin Nano Super setup.

# Application
SAEDGE_APP_NAME=SAEDGE Embodied AI Studio
SAEDGE_DEBUG=false
SAEDGE_SIMULATION=true          # Set false when running on real SO-ARM101 hardware

# Network
SAEDGE_HOST=0.0.0.0
SAEDGE_PORT=8000
SAEDGE_CORS_ORIGINS=*

# Hardware (Jetson udev device names)
SAEDGE_LEADER_DEVICE=/dev/so101_leader
SAEDGE_FOLLOWER_DEVICE=/dev/so101_follower
SAEDGE_LEADER_BAUDRATE=1000000
SAEDGE_FOLLOWER_BAUDRATE=1000000

# Cameras
SAEDGE_ENV_CAMERA_INDEX=0
SAEDGE_WRIST_CAMERA_INDEX=2
SAEDGE_CAMERA_WIDTH=640
SAEDGE_CAMERA_HEIGHT=480
SAEDGE_CAMERA_FPS=15

# Safety / motion limits
SAEDGE_MAX_SPEED=1.0
SAEDGE_MAX_ACCEL=2.0

# AI
SAEDGE_INFERENCE_DEVICE=cpu
SAEDGE_DETECTION_THRESHOLD=0.5
SAEDGE_TRAINING_ENABLED=false   # Disable during autonomous operation

# Data directories
SAEDGE_DATASETS_DIR=datasets
SAEDGE_MODELS_DIR=models
SAEDGE_CALIBRATION_DIR=calibration
SAEDGE_LOGS_DIR=logs
